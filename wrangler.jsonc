{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "three-birds",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/agents/*",
      "/oauth/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ChatAgent",
        "name": "ChatAgent"
      },
      {
        "class_name": "BirdVoiceAgent",
        "name": "BirdVoiceAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": [
        "ChatAgent"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": [
        "BirdVoiceAgent"
      ],
      "tag": "v2"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}